        </section>

            <section class="card" aria-labelledby="hobbies-heading">
                  <h2 id="hobbies-heading">Hobbies</h2>
                  <div class="hobbies-grid" role="list">
                    <article class="hobby-item" data-hobby="photography" role="listitem">
                      <div class="hobby-glow" aria-hidden="true"></div>
                      <div class="hobby-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
