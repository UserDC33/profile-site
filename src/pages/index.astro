                        <span>Street</span><span>Architecture</span><span>Film</span>
                      </div>
                    </article>
                    <article class="hobby-item" data-hobby="coding" role="listitem">
                      <div class="hobby-glow" aria-hidden="true"></div>
                      <div class="hobby-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
