                <style>
                  .hobbies-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                    gap: 1.25rem;
                    margin-top: 1.5rem;
                  }
                  .hobby-item {
                    position: relative;
                    padding: 1.75rem 1.5rem;
                    background: var(--card);
                    border: 1px solid var(--border);
                    border-radius: 20px;
                    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s, border-color 0.3s;
                    overflow: hidden;
                    opacity: 0;
                    transform: translateY(20px);
                    animation: hobby-reveal 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
                  }
                  .hobby-item:nth-child(1) { animation-delay: 0.1s; }
                  .hobby-item:nth-child(2) { animation-delay: 0.2s; }
                  .hobby-item:nth-child(3) { animation-delay: 0.3s; }
                  @keyframes hobby-reveal {
                    to { opacity: 1; transform: translateY(0); }
                  }
                  .hobby-glow {
                    position: absolute;
                    inset: -50%;
                    opacity: 0;
                    transition: opacity 0.4s;
                    pointer-events: none;
                    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), var(--glow-color), transparent 70%);
                  }
                  .hobby-item:hover .hobby-glow { opacity: 0.15; }
                  [data-hobby="photography"] { --glow-color: #f59e0b; }
                  [data-hobby="coding"] { --glow-color: #3b82f6; }
                  [data-hobby="cycling"] { --glow-color: #22c55e; }
                  .hobby-item::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    border-radius: 20px;
                    padding: 1px;
                    background: linear-gradient(135deg, transparent, transparent);
                    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                    -webkit-mask-composite: xor;
                    mask-composite: exclude;
                    opacity: 0;
                    transition: opacity 0.3s, background 0.3s;
                  }
                  .hobby-item:hover::before {
                    opacity: 1;
                    background: linear-gradient(135deg, var(--glow-color), var(--glow-color-2));
                  }
                  [data-hobby="photography"] { --glow-color-2: #f97316; }
                  [data-hobby="coding"] { --glow-color-2: #8b5cf6; }
                  [data-hobby="cycling"] { --glow-color-2: #16a34a; }
