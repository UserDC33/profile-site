                <style>
          .creations-collage {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            grid-auto-rows: 220px;
            gap: 1rem;
            grid-auto-flow: dense;
          }
          .creation-item {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            background: var(--card);
            border: 1px solid var(--border);
          }
          .creation-item.large {
            grid-column: span 2;
            grid-row: span 2;
          }
          .creation-link {
            display: block;
            width: 100%;
            height: 100%;
            text-decoration: none;
            color: inherit;
          }
          .creation-link img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
          }
          .creation-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 40%, rgba(15, 23, 42, 0.95) 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.25rem;
            opacity: 0;
            transition: opacity 0.3s ease;
          }
          .creation-item:hover .creation-overlay {
            opacity: 1;
          }
          .creation-item:hover img {
            transform: scale(1.05);
          }
          .creation-info h3 {
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            margin-bottom: 0.25rem;
            transform: translateY(10px);
            transition: transform 0.3s ease;
          }
          .creation-info p {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.7);
            transform: translateY(10px);
            transition: transform 0.3s ease 0.05s;
          }
          .creation-item:hover .creation-info h3,
          .creation-item:hover .creation-info p {
            transform: translateY(0);
          }
          .zoom-icon {
            align-self: flex-end;
            color: white;
            opacity: 0.8;
            transform: scale(0.8);
            transition: transform 0.3s ease, opacity 0.3s ease;
          }
          .creation-item:hover .zoom-icon {
            transform: scale(1);
            opacity: 1;
          }
          .creation-item.placeholder {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
