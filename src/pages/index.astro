<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Personal profile — About me, projects, and contact." />
  <title>Bara Arkantara | Profile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #fafafa;
      --fg: #1a1a2e;
      --muted: #6b7280;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --card: #ffffff;
      --border: #e5e7eb;
      --max-w: 720px;
      --space: 1.5rem;
    }
    @media (prefers-color-scheme: dark) {
          :root {
            --bg: #0f172a;
            --fg: #f1f5f9;
            --muted: #94a3b8;
            --accent: #3b82f6;
            --accent-hover: #60a5fa;
            --card: #1e293b;
            --border: #334155;
          }
          body {
            background-image: 
              radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.15) 0%, transparent 50%),
              radial-gradient(circle at 80% 20%, rgba(96, 165, 250, 0.1) 0%, transparent 50%),
              linear-gradient(180deg, var(--bg) 0%, var(--bg) 100%);
          }
        }
    * { box-sizing: border-box; margin: 0; padding: 0; }
            body {
              font-family: "Montserrat", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
              background: var(--bg);
          background-image: 
            radial-gradient(circle at 20% 80%, rgba(30, 58, 138, 0.15) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(37, 99, 235, 0.1) 0%, transparent 50%),
            linear-gradient(180deg, var(--bg) 0%, var(--bg) 100%);
          color: var(--fg);
          line-height: 1.6;
          min-height: 100vh;
          display: flex;
          flex-direction: column;
        }
    .container {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: calc(var(--space) * 3) var(--space);
    }
    header { margin-bottom: calc(var(--space) * 2); text-align: center; }
        .header-content { display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; }
        .avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid var(--accent); box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
        h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
    .tagline { color: var(--muted); font-size: 1.125rem; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: calc(var(--space) * 1.5);
      margin-bottom: var(--space);
    }
    .card h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
    .card h2::before { content: ""; width: 4px; height: 1.25rem; background: var(--accent); border-radius: 2px; }
    .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
    .link {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.5rem 1rem; background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; color: var(--fg); text-decoration: none; font-size: 0.875rem;
      transition: border-color 0.2s, background 0.2s;
    }
    .link:hover { border-color: var(--accent); background: var(--accent); color: white; }
    .link:hover svg { stroke: white; }
    .link svg { width: 18px; height: 18px; stroke: currentColor; flex-shrink: 0; }
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem; }
    .gallery img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s; }
    .gallery img:hover { transform: scale(1.02); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
    .gallery a { text-decoration: none; color: inherit; }
    footer { text-align: center; color: var(--muted); font-size: 0.875rem; padding: var(--space); margin-top: auto; }
        @media (max-width: 480px) {
          .container { padding: calc(var(--space) * 2) 1rem; }
          .card { padding: var(--space); }
          .gallery { grid-template-columns: 1fr; }
        }

        /* Minimalist effects */
        @media (prefers-reduced-motion: no-preference) {
          .card {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
          }
          .card.visible {
            opacity: 1;
            transform: translateY(0);
          }
          header {
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
          }
          header.visible {
            opacity: 1;
            transform: translateY(0);
          }
          .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
            border-color: var(--accent);
          }
          .gallery img:hover {
            transform: scale(1.03);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
          }
        }
        @media (prefers-reduced-motion: reduce) {
          .card, header, .gallery img { transition: none !important; animation: none !important; }
        }
        .link:focus-visible, .gallery a:focus-visible {
          outline: 2px solid var(--accent);
          outline-offset: 2px;
        }
        .card { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  </style>
</head>
<body>
  <div class="container">
    <header>
            <div class="header-content">
              <img src="/profile-site/photos/avatar.jpg" alt="Bara Arkantara" class="avatar" />
              <div>
                <h1>Bara Arkantara</h1>
                <p class="tagline">Student • Developer • Curious Builder</p>
              </div>
            </div>
          </header>

        <section class="card about-card" aria-labelledby="about-heading">
                  <div class="about-bg" aria-hidden="true"></div>
                  <h2 id="about-heading">About</h2>
                  <div class="about-content">
                    <p class="lead">Hi, I'm <strong>Bara Arkantara</strong> — a high school student at <strong>SMA Angkasa 1 Jakarta</strong> currently serving in <strong>OSIS</strong> (Student Council).</p>
                    <p>I enjoy building things for the web, learning new frameworks, and solving problems with code. When I'm not coding, you'll find me reading, gaming, or hanging out with friends.</p>
                    <div class="exploring">
                      <span class="exploring-label">Currently exploring</span>
                      <div class="exploring-tags">
                        <span class="explore-tag"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>Astro</span>
                        <span class="explore-tag"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>TypeScript</span>
                        <span class="explore-tag"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>Modern CSS</span>
                      </div>
                    </div>
                  </div>
                </section>

                <style>
                  .about-card { position: relative; overflow: hidden; }
                  .about-bg {
                    position: absolute;
                    inset: 0;
                    background-image:
                      radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.08) 0%, transparent 40%),
                      radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.06) 0%, transparent 40%),
                      linear-gradient(180deg, transparent 0%, var(--card) 100%);
                    pointer-events: none;
                  }
                  .about-content { position: relative; z-index: 1; }
                  .lead { font-size: 1.05rem; line-height: 1.7; color: var(--fg); margin-bottom: 1rem; }
                  .exploring { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
                  .exploring-label { display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 0.75rem; }
                  .exploring-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
                  .explore-tag {
                    display: inline-flex; align-items: center; gap: 0.375rem;
                    padding: 0.375rem 0.75rem;
                    background: rgba(59, 130, 246, 0.1);
                    border: 1px solid rgba(59, 130, 246, 0.2);
                    border-radius: 999px;
                    font-size: 0.8rem;
                    font-weight: 500;
                    color: var(--accent);
                    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
                  }
                  .explore-tag:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
                    background: rgba(59, 130, 246, 0.15);
                  }
                  .explore-tag svg { flex-shrink: 0; }
                </style>

    <section class="card timeline-card" aria-labelledby="education-heading">
          <h2 id="education-heading">Education</h2>
          <div class="timeline" role="list">
            <article class="timeline-item" role="listitem">
              <div class="timeline-dot" aria-hidden="true"></div>
              <div class="timeline-content">
                <time class="timeline-date" datetime="2024">2024 – 2026</time>
                <h3 class="timeline-title">Nassa School</h3>
                <p class="timeline-subtitle">Junior High School</p>
              </div>
            </article>
            <article class="timeline-item current" role="listitem" aria-current="true">
              <div class="timeline-dot" aria-hidden="true"></div>
              <div class="timeline-content">
                <time class="timeline-date" datetime="2026">2026 – Present</time>
                <h3 class="timeline-title">SMA Angkasa 1 Jakarta</h3>
                <p class="timeline-subtitle">High School Student</p>
                <p class="timeline-desc">Active in OSIS: organizing events, managing student aspirations, and contributing to school community.</p>
              </div>
            </article>
          </div>
        </section>

        <style>
          .timeline-card { padding-bottom: calc(var(--space) * 1.5); }
          .timeline {
            display: flex;
            flex-direction: column;
            gap: 0;
          }
          .timeline-item {
            position: relative;
            padding-left: 2.5rem;
            padding-bottom: 2.5rem;
          }
          .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 7px;
            top: 28px;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, var(--border), transparent);
          }
          .timeline-dot {
            position: absolute;
            left: 0;
            top: 12px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--accent);
            border: 3px solid var(--card);
            box-shadow: 0 0 0 2px var(--accent);
            z-index: 1;
          }
          .timeline-item.current .timeline-dot {
            animation: pulse 2s ease-in-out infinite;
          }
          @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 2px var(--accent); }
            50% { box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.3); }
          }
          @media (prefers-reduced-motion: reduce) {
            .timeline-item.current .timeline-dot { animation: none; }
          }
          .timeline-content { padding-left: 1rem; }
          .timeline-date {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--accent);
            margin-bottom: 0.5rem;
          }
          .timeline-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--fg);
            margin-bottom: 0.25rem;
          }
          .timeline-subtitle {
            font-size: 0.9rem;
            color: var(--muted);
            margin-bottom: 0.5rem;
          }
          .timeline-desc {
            font-size: 0.85rem;
            color: var(--muted);
            line-height: 1.6;
          }
        </style>

    <section class="card" aria-labelledby="skills-heading">
